    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 三角形 -->
    <path android:pathData="M36,36 L72,36 L54,62 Z"
        android:strokeColor="#2EA855F7" android:strokeWidth="15" android:strokeLineJoin="round" />
