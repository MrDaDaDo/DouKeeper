<?xml version="1.0" encoding="utf-8"?>
<!--
  App 圖示前景：書籤（Keeper＝收藏、留住）＋中間鏤空的播放三角（影片），加青紅錯位殘影。

  配色照抖音（使用者指定，2026-10-13）：黑底、白色主體、左上青 #25F4EE、右下紅 #FE2C55。
  符號是自己的書籤造型，不用抖音的音符。只適合自用側載——
  **若日後要公開發佈，這組配色必須換掉**：黑底＋白主體＋青紅錯位是抖音的品牌識別。

  三層同一個形狀，都用 evenOdd 把播放三角挖空：白色層的洞會透出底下錯開的青、紅兩層，
  洞的邊緣也帶出錯位色，跟外框的殘影是同一種效果。

  安全區：自適應圖示只保證中央直徑 66 的圓不被裁（21–87）。書籤落在 x 36–72、y 28–82。
  形狀與 ic_launcher_monochrome.xml 相同（那份給 Android 13 主題圖示用）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="-2.2" android:translateY="-2.2">
        <path android:fillColor="#FF25F4EE" android:fillType="evenOdd"
            android:pathData="M42,30 H66 A4,4 0 0 1 70,34 V80 L54,68 L38,80 V34 A4,4 0 0 1 42,30 Z M49,40 L49,58 L63,49 Z" />
    </group>

    <group android:translateX="2.2" android:translateY="2.2">
        <path android:fillColor="#FFFE2C55" android:fillType="evenOdd"
            android:pathData="M42,30 H66 A4,4 0 0 1 70,34 V80 L54,68 L38,80 V34 A4,4 0 0 1 42,30 Z M49,40 L49,58 L63,49 Z" />
    </group>

    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M42,30 H66 A4,4 0 0 1 70,34 V80 L54,68 L38,80 V34 A4,4 0 0 1 42,30 Z M49,40 L49,58 L63,49 Z" />
</vector>
