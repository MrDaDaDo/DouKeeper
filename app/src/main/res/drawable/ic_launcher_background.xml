<?xml version="1.0" encoding="utf-8"?>
<!--
  App 圖示背景：近黑色，中央帶一點紫色暗光，讓前景的霓虹看起來像打在牆上。

  黑底霓虹是使用者選的風格方向（2026-10-13）。只取「深色、高對比、會發光」的感覺；
  抖音的音符商標與青紅錯位殘影都不用——那是它的品牌識別，桌面上也會跟抖音本人搞混。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="76">
                <item android:offset="0" android:color="#FF24123A" />
                <item android:offset="0.55" android:color="#FF110A1C" />
                <item android:offset="1" android:color="#FF07060C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
